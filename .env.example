# --- Model ------------------------------------------------------------------
# The only credential Jarvis needs to think. Without it the dashboard still
# works and chat says why it cannot answer.
ANTHROPIC_API_KEY=sk-ant-...

# JARVIS_MODEL=claude-opus-5
# JARVIS_EFFORT=high              # low | medium | high | xhigh | max
# JARVIS_MAX_GRAPH_STEPS=12

# --- LLM gateway (optional) -------------------------------------------------
# With a LiteLLM proxy in front, ANTHROPIC_API_KEY above holds the proxy's
# virtual key, Claude goes through its Anthropic pass-through and local/*
# models (Ollama on the GPU machine) become pickable in the chat.
# `docker compose --profile gateway up` runs one locally with docker/litellm.yaml.
# JARVIS_LLM_GATEWAY_URL=http://localhost:4000
# Probed to tell whether the GPU machine is on; while it is off a local model
# request is answered by JARVIS_LOCAL_FALLBACK_MODEL instead.
# JARVIS_OLLAMA_URL=http://pop-os.<tailnet>.ts.net:11434
# JARVIS_LOCAL_FALLBACK_MODEL=claude-haiku-4-5
# Only for the local proxy: the real key it calls Anthropic with.
# LITELLM_ANTHROPIC_API_KEY=sk-ant-...

# --- Development ------------------------------------------------------------
# Serve every capability from fixtures: no tokens, no network, no cluster.
# Start here.
JARVIS_FAKE_TOOLS=true

# --- Backing stores ---------------------------------------------------------
# Unset means in-process memory: everything works, but a restart forgets
# pending approvals and past runs.
# JARVIS_DATABASE_URL=postgresql://jarvis:jarvis@localhost:5432/jarvis
# JARVIS_REDIS_URL=redis://localhost:6379/0

# --- GitHub (github + ghcr capabilities) ------------------------------------
# Fine-grained PAT. Needs: Contents read/write, Pull requests read/write,
# Checks read, and read:packages for GHCR.
# JARVIS_GITHUB_TOKEN=github_pat_...
# JARVIS_GITHUB_OWNER=gmottola00
# JARVIS_GITHUB_INFRA_REPO=Home-Lab-Infra

# --- ArgoCD -----------------------------------------------------------------
# The tailnet address of the ArgoCD ingress, plus a token from a local account.
# JARVIS_ARGOCD_BASE_URL=https://argocd.<tailnet>.ts.net
# JARVIS_ARGOCD_TOKEN=eyJ...

# --- Kubernetes -------------------------------------------------------------
# Read-only kubeconfig. Left unset, Jarvis tries in-cluster then the default
# kubeconfig path.
# JARVIS_KUBECONFIG=/home/gmottola/.kube/config

# --- API --------------------------------------------------------------------
# JARVIS_LOG_LEVEL=INFO
# JARVIS_LOG_JSON=false
# JARVIS_CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]
